#!/usr/bin/env zsh

builtin emulate -L zsh
setopt EXTENDED_GLOB
setopt PUSHD_SILENT
setopt ERR_EXIT
setopt ERR_RETURN
setopt NO_UNSET
setopt PIPE_FAIL
setopt NO_AUTO_PUSHD
setopt NO_PUSHD_IGNORE_DUPS
setopt FUNCTION_ARGZERO

## Enable for script debugging
# setopt WARN_CREATE_GLOBAL
# setopt WARN_NESTED_VAR
# setopt XTRACE

if (( ! ${+CI} )) {
  print -u2 -PR "%F{1}    ✖︎ ${ZSH_ARGZERO:t:r} requires CI environment.%f"
  exit 1
}

autoload -Uz is-at-least && if ! is-at-least 5.9; then
  print -u2 -PR "${CI:+::error::}%F{1}${funcstack[1]##*/}:%f Running on Zsh version %B${ZSH_VERSION}%b, but Zsh %B5.2%b is the minimum supported version. Upgrade Zsh to fix this issue."
  exit 1
fi

TRAPZERR() {
  print -u2 -PR "::error::%F{1}    ✖︎ script execution error%f"
  print -PR -e "
  Callstack:
  ${(j:\n     :)funcfiletrace}
  "

  exit 2
}

build() {
  if (( ! ${+SCRIPT_HOME} )) typeset -g SCRIPT_HOME=${ZSH_ARGZERO:A:h}
  local host_os='macos'
  local project_root=${SCRIPT_HOME:A:h:h}
  local buildspec_file=${project_root}/buildspec.json

  fpath=("${SCRIPT_HOME}/utils.zsh" ${fpath})
  autoload -Uz log_group log_info log_error log_output check_macos setup_ccache

  if [[ ! -r ${buildspec_file} ]] {
    log_error \
      'No buildspec.json found. Please create a build specification for your project.'
    return 2
  }

  local -i debug=0

  local config='RelWithDebInfo'
  local -r -a _valid_configs=(Debug RelWithDebInfo Release MinSizeRel)
  local -i codesign=0

  local -a args
  while (( # )) {
    case ${1} {
      -c|--config)
        if (( # == 1 )) || [[ ${2:0:1} == '-' ]] {
          log_error "Missing value for option %B${1}%b"
          log_output ${_usage}
          exit 2
        }
        ;;
    }
    case ${1} {
      --) shift; args+=($@); break ;;
      -c|--config)
        if (( ! ${_valid_configs[(Ie)${2}]} )) {
          log_error "Invalid value %B${2}%b for option %B${1}%b"
          exit 2
        }
        config=${2}
        shift 2
        ;;
      -s|--codesign) codesign=1; shift ;;
      --debug) debug=1; shift ;;
      *) log_error "Unknown option: %B${1}%b"; exit 2 ;;
    }
  }

  set -- ${(@)args}

  check_macos

  local product_name
  local product_version
  read -r product_name product_version <<< \
    "$(jq -r '. | {name, version} | join(" ")' ${buildspec_file})"

  pushd ${project_root}

  local -a cmake_args=()
  local -a cmake_build_args=(--build)
  local -a cmake_install_args=(--install)

  if (( debug )) cmake_args+=(--debug-output)

  cmake_args+=(--preset 'macos-ci')
  cmake_args+=(-DLibShout_ROOT=/tmp/libshout-universal)
  cmake_args+=(-DLibLame_ROOT=/tmp/liblame-universal)
  cmake_args+=(-DLibOgg_ROOT=/tmp/libogg-universal)
  cmake_args+=(-DLibOpus_ROOT=/tmp/libopus-universal)
  cmake_args+=(-DLibVorbis_ROOT=/tmp/libvorbis-universal)
  cmake_args+=(-DOPENSSL_ROOT_DIR=/tmp/openssl-universal)

  typeset -gx NSUnbufferedIO=YES

  typeset -gx CODESIGN_IDENT="${CODESIGN_IDENT:--}"
  if (( codesign )) && [[ -z ${CODESIGN_TEAM} ]] {
    typeset -gx CODESIGN_TEAM="$(print "${CODESIGN_IDENT}" | /usr/bin/sed -En 's/.+\((.+)\)/\1/p')"
  }

  log_group "Building Universal libogg (libshout dependency)..."
  curl -sSL https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz \
    -o /tmp/libogg.tar.gz
  tar -xzf /tmp/libogg.tar.gz -C /tmp
  mv /tmp/libogg-1.3.5 /tmp/libogg-src
  pushd /tmp/libogg-src

  mkdir build-arm64 && pushd build-arm64
  ../configure --prefix=/tmp/libogg-arm64 \
    CFLAGS="-arch arm64" LDFLAGS="-arch arm64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  mkdir build-x86_64 && pushd build-x86_64
  ../configure --prefix=/tmp/libogg-x86_64 \
    CFLAGS="-arch x86_64" LDFLAGS="-arch x86_64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd
  popd
  log_group

  log_group "Building Universal openssl@3 (libshout TLS backend)..."
  # libshout's configure accepts --with-openssl=<prefix> and reads -I$prefix/include
  # and -L$prefix/lib directly (XIPH_PATH_SSL macro, no pkg-config involvement),
  # so per-arch prefixes work without PKG_CONFIG_PATH juggling.  `no-shared` builds
  # libssl.a + libcrypto.a only; `no-tests` skips the self-test build which takes
  # ~minutes and is unnecessary in CI.  openssl's build system is in-tree (not
  # out-of-tree like autotools); `make clean` between arches resets object files.
  curl -sSL --retry 3 https://www.openssl.org/source/openssl-3.3.2.tar.gz \
    -o /tmp/openssl.tar.gz
  tar -xzf /tmp/openssl.tar.gz -C /tmp
  mv /tmp/openssl-3.3.2 /tmp/openssl-src
  pushd /tmp/openssl-src

  # NB: openssl's darwin64-*-cc targets already imply -arch <foo>; passing
  # -arch on top of that trips Configure's "target already defined" error
  # (`target already defined - darwin64-arm64-cc (offending arg: arm64)`).
  # So just pick the target and don't add redundant arch flags.
  ./Configure darwin64-arm64-cc --prefix=/tmp/openssl-arm64 no-shared no-tests
  make -j$(sysctl -n hw.ncpu) && make install_sw
  make clean

  ./Configure darwin64-x86_64-cc --prefix=/tmp/openssl-x86_64 no-shared no-tests
  make -j$(sysctl -n hw.ncpu) && make install_sw
  popd

  # Lipo the static archives into a Universal pair so the plugin can link a
  # single arch-agnostic openssl at the cmake layer (see CMakeLists.txt APPLE
  # block).  Headers are identical between the two arch prefixes except for
  # opensslconf.h, which branches on __i386__/__x86_64__/__arm64__ at compile
  # time — so a single header copy works for both slices of the fat binary.
  mkdir -p /tmp/openssl-universal/lib /tmp/openssl-universal/include
  for lib in libssl.a libcrypto.a; do
    lipo -create \
      /tmp/openssl-arm64/lib/${lib} \
      /tmp/openssl-x86_64/lib/${lib} \
      -output /tmp/openssl-universal/lib/${lib}
  done
  cp -R /tmp/openssl-arm64/include/openssl /tmp/openssl-universal/include/
  log_group

  log_group "Building Universal libshout..."
  curl -sSL https://downloads.xiph.org/releases/libshout/libshout-2.4.6.tar.gz \
    -o /tmp/libshout.tar.gz
  tar -xzf /tmp/libshout.tar.gz -C /tmp
  mv /tmp/libshout-2.4.6 /tmp/icecast-libshout
  pushd /tmp/icecast-libshout

  # arm64 slice — static build with arch-matched openssl + libogg.  Optional
  # codec deps (theora/speex/opus) stay disabled: we only use MP3 and Opus,
  # and libshout's "opus" support is for Ogg-Opus container passthrough which
  # we handle ourselves via libogg in src/radio-opus-encoder.c.
  # --with-openssl: enable the TLS path (takes no DIR argument on libshout
  # 2.4.6 — XIPH_PATH_SSL's macro is yes/no; prefix is discovered via
  # pkg-config).  Point PKG_CONFIG_LIBDIR at both libogg and openssl so
  # libshout's OGG + openssl probes both hit our arch-matched builds.
  # -Wno-error=implicit-function-declaration: libshout 2.4.6 legacy.c/icy.c
  # miss stdlib.h/stdio.h includes; Apple Clang 16 promotes this warning to
  # an error.
  mkdir build-arm64 && pushd build-arm64
  PKG_CONFIG_LIBDIR=/tmp/libogg-arm64/lib/pkgconfig:/tmp/openssl-arm64/lib/pkgconfig \
    ../configure --prefix=/tmp/libshout-arm64 \
      --disable-shared --enable-static \
      --with-openssl \
      --without-theora --without-speex --without-opus \
      CFLAGS="-arch arm64 -Wno-error=implicit-function-declaration" \
      LDFLAGS="-arch arm64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  # x86_64 slice — same flags against the x86_64 openssl prefix.
  mkdir build-x86_64 && pushd build-x86_64
  PKG_CONFIG_LIBDIR=/tmp/libogg-x86_64/lib/pkgconfig:/tmp/openssl-x86_64/lib/pkgconfig \
    ../configure --prefix=/tmp/libshout-x86_64 \
      --disable-shared --enable-static \
      --with-openssl \
      --without-theora --without-speex --without-opus \
      CFLAGS="-arch x86_64 -Wno-error=implicit-function-declaration" \
      LDFLAGS="-arch x86_64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  # Merge static archives with lipo.  The switch from .dylib to .a here is
  # deliberate: a .dylib would embed openssl's .a at libshout-link time and we
  # could stop there, but a static archive means the plugin's .plugin bundle
  # has zero external runtime deps (verified via `otool -L`), which matches
  # how liblame and libopus are packaged.  Cost: the plugin itself must now
  # link ssl+crypto (done in CMakeLists.txt); benefit: one self-contained
  # bundle with no dyld resolution of libssl/libcrypto at OBS launch.
  mkdir -p /tmp/libshout-universal/lib /tmp/libshout-universal/include
  lipo -create \
    /tmp/libshout-arm64/lib/libshout.a \
    /tmp/libshout-x86_64/lib/libshout.a \
    -output /tmp/libshout-universal/lib/libshout.a
  cp -r /tmp/libshout-arm64/include/shout /tmp/libshout-universal/include/
  popd

  # TLS-symbol sanity check.  If libshout's configure silently fell back to
  # the non-TLS path (e.g. a malformed --with-openssl path), the archive will
  # still build and link — but `shout_set_tls` will return SHOUTERR_UNSUPPORTED
  # at runtime with no link-time warning.  We prove TLS was compiled in by
  # checking that `shout_tls_new` is DEFINED (T marker) in the archive:
  # libshout's `src/tls.c` wraps its entire body in `#ifdef HAVE_OPENSSL`,
  # so if config.h doesn't define HAVE_OPENSSL, `shout_tls_new` never gets
  # emitted as a symbol — which is exactly the failure mode we want to catch.
  #
  # Don't use a raw openssl symbol like `_SSL_connect` here: libshout calls
  # into openssl through a mix of functions (SSL_new / SSL_do_handshake /
  # OPENSSL_sk_num / etc.) and the exact entry point set varies by libshout
  # patch version.  `_shout_tls_new` is libshout's own function and its
  # existence is an unambiguous "HAVE_OPENSSL was defined at compile time".
  #
  # Check the per-arch archives, NOT the lipo'd Universal: nm on a fat file
  # wrapping two .a archives is non-deterministic about which slice's symbol
  # table it surfaces on the arm64 runner.  Per-arch archives are plain
  # ar(1) output and nm reads them reliably.
  for arch in arm64 x86_64; do
    local archive=/tmp/libshout-${arch}/lib/libshout.a
    if ! nm "${archive}" 2>/dev/null | grep -qE ' T _shout_tls_new$'; then
      log_error "libshout.a (${arch}) has no _shout_tls_new definition — TLS did not compile in"
      nm "${archive}" 2>&1 | grep -E '_shout_tls_|_shout_connection_starttls' | head -20 || true
      return 2
    fi
  done
  log_info "libshout.a TLS symbols present (_shout_tls_new defined in both arm64 and x86_64 slices)"
  log_group

  log_group "Building Universal libmp3lame..."
  curl -sSL https://downloads.sourceforge.net/lame/lame-3.100.tar.gz \
    -o /tmp/lame.tar.gz
  tar -xzf /tmp/lame.tar.gz -C /tmp
  mv /tmp/lame-3.100 /tmp/lame-src
  pushd /tmp/lame-src

  mkdir build-arm64 && pushd build-arm64
  ../configure --prefix=/tmp/liblame-arm64 \
    --disable-frontend --disable-shared --enable-static \
    CC=clang \
    CFLAGS="-arch arm64" LDFLAGS="-arch arm64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  mkdir build-x86_64 && pushd build-x86_64
  # --host tells autoconf to target x86_64 (enabling x86 code paths like SSE).
  # --disable-shared skips the .dylib link step that requires _lame_init_old via
  # libtool's -u flag — which fails in an Apple-Clang cross-compile environment.
  # CC=clang prevents autoconf from looking for x86_64-apple-darwin-gcc.
  ../configure --prefix=/tmp/liblame-x86_64 \
    --disable-frontend --disable-shared --enable-static \
    --host=x86_64-apple-darwin \
    CC=clang \
    CFLAGS="-arch x86_64" LDFLAGS="-arch x86_64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  # Merge with lipo — use static library so the plugin embeds lame rather than
  # depending on a dylib that may not be present on the user's system.
  mkdir -p /tmp/liblame-universal/lib /tmp/liblame-universal/include
  lipo -create \
    /tmp/liblame-arm64/lib/libmp3lame.a \
    /tmp/liblame-x86_64/lib/libmp3lame.a \
    -output /tmp/liblame-universal/lib/libmp3lame.a
  cp -r /tmp/liblame-arm64/include/lame /tmp/liblame-universal/include/
  popd
  log_group

  log_group "Lipo-merging Universal libogg (for our own Ogg container code)..."
  # libogg was already built per-arch as a libshout dependency above.  Lipo the
  # static archives together so the plugin can link against a Universal libogg
  # without depending on an arch-specific path.
  mkdir -p /tmp/libogg-universal/lib /tmp/libogg-universal/include
  lipo -create \
    /tmp/libogg-arm64/lib/libogg.a \
    /tmp/libogg-x86_64/lib/libogg.a \
    -output /tmp/libogg-universal/lib/libogg.a
  cp -r /tmp/libogg-arm64/include/ogg /tmp/libogg-universal/include/
  log_group

  log_group "Building Universal libopus..."
  curl -sSL https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz \
    -o /tmp/opus.tar.gz
  tar -xzf /tmp/opus.tar.gz -C /tmp
  mv /tmp/opus-1.5.2 /tmp/opus-src
  pushd /tmp/opus-src

  mkdir build-arm64 && pushd build-arm64
  ../configure --prefix=/tmp/libopus-arm64 \
    --disable-shared --enable-static \
    CC=clang \
    CFLAGS="-arch arm64" LDFLAGS="-arch arm64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  mkdir build-x86_64 && pushd build-x86_64
  # --host=x86_64-apple-darwin matches the libmp3lame recipe: without it,
  # AC_CANONICAL_HOST sees the arm64 runner and skips x86-specific code paths,
  # yet CFLAGS="-arch x86_64" still produces x86_64 object code — arch
  # mismatch at link time.  CC=clang prevents autoconf from looking for a
  # nonexistent x86_64-apple-darwin-gcc.
  ../configure --prefix=/tmp/libopus-x86_64 \
    --disable-shared --enable-static \
    --host=x86_64-apple-darwin \
    CC=clang \
    CFLAGS="-arch x86_64" LDFLAGS="-arch x86_64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  mkdir -p /tmp/libopus-universal/lib /tmp/libopus-universal/include
  lipo -create \
    /tmp/libopus-arm64/lib/libopus.a \
    /tmp/libopus-x86_64/lib/libopus.a \
    -output /tmp/libopus-universal/lib/libopus.a
  cp -r /tmp/libopus-arm64/include/opus /tmp/libopus-universal/include/
  popd
  log_group

  log_group "Building Universal libvorbis..."
  # libvorbis depends on libogg (already built per-arch above as a libshout
  # dependency).  --disable-oggtest skips a configure-time test program that
  # would be cross-compiled for x86_64 and fail to run on the arm64 runner;
  # PKG_CONFIG_LIBDIR points the ogg probe at the matching arch's pkgconfig.
  # libvorbis is pure C with no AC_CANONICAL_HOST arch dispatch (unlike opus
  # and lame), so the x86_64 slice needs no --host override — same as libogg.
  curl -sSL --retry 3 https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz \
    -o /tmp/libvorbis.tar.gz
  tar -xzf /tmp/libvorbis.tar.gz -C /tmp
  mv /tmp/libvorbis-1.3.7 /tmp/libvorbis-src
  pushd /tmp/libvorbis-src

  mkdir build-arm64 && pushd build-arm64
  PKG_CONFIG_LIBDIR=/tmp/libogg-arm64/lib/pkgconfig \
    ../configure --prefix=/tmp/libvorbis-arm64 \
      --disable-shared --enable-static --disable-oggtest \
      CFLAGS="-arch arm64" LDFLAGS="-arch arm64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd

  mkdir build-x86_64 && pushd build-x86_64
  PKG_CONFIG_LIBDIR=/tmp/libogg-x86_64/lib/pkgconfig \
    ../configure --prefix=/tmp/libvorbis-x86_64 \
      --disable-shared --enable-static --disable-oggtest \
      CFLAGS="-arch x86_64" LDFLAGS="-arch x86_64"
  make -j$(sysctl -n hw.ncpu) && make install
  popd
  popd

  # Lipo-merge both archives (core + encode-only).  The plugin links both; see
  # cmake/FindLibVorbis.cmake for the enc -> core -> ogg ordering rationale.
  mkdir -p /tmp/libvorbis-universal/lib /tmp/libvorbis-universal/include
  for lib in libvorbis.a libvorbisenc.a; do
    lipo -create \
      /tmp/libvorbis-arm64/lib/${lib} \
      /tmp/libvorbis-x86_64/lib/${lib} \
      -output /tmp/libvorbis-universal/lib/${lib}
  done
  cp -r /tmp/libvorbis-arm64/include/vorbis /tmp/libvorbis-universal/include/
  log_group

  log_group "Configuring ${product_name}..."
  cmake -S ${project_root} ${cmake_args}

  log_group "Building ${product_name}..."
  run_xcodebuild() {
    if (( debug )) {
      xcodebuild ${@}
    } else {
      if [[ ${GITHUB_EVENT_NAME} == push ]] {
        xcodebuild ${@} 2>&1 | xcbeautify --renderer terminal
      } else {
        xcodebuild ${@} 2>&1 | xcbeautify --renderer github-actions
      }
    }
  }

  local -a build_args=(
    ONLY_ACTIVE_ARCH=NO
    -arch arm64
    -arch x86_64
    -project ${product_name}.xcodeproj
    -target ${product_name}
    -destination "generic/platform=macOS,name=Any Mac"
    -configuration ${config}
    -parallelizeTargets
    -hideShellScriptEnvironment
    build
  )

  pushd build_macos
  run_xcodebuild ${build_args}
  popd

  log_group "Installing ${product_name}..."
  cmake --install build_macos --config ${config} --prefix "${project_root}/release/${config}"

  popd
  log_group
}

build ${@}
