# Exclude everything
/*

# Except for default project files
!/.clang-tidy
!/.github
!/.pre-commit-config.yaml
!/build-aux
!/cmake
!/data
!/deps
!/docs
!/scripts
!/src
!/tests
!.clang-format
!.gersemirc
!.gitattributes
!.gitignore
!buildspec.json
!CHANGELOG.md
!CMakeLists.txt
!CMakePresets.json
!cliff.toml
!LICENSE
!README.md
!vcpkg.json

# Exclude generated local dev helpers
/build-and-install-macos.sh

# Exclude Windows dependency build output (deps/libshout-win/build.ps1)
/build-deps

# Exclude clang-tidy local build directory
/build-tidy

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# clangd / IDE compile database (local only)
/build-clangd
/compile_commands.json
